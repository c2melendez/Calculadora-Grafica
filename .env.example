# Orígenes CORS permitidos, separados por comas. Obligatorio — sin default
# (spec, sección 9: nunca "*" con allow_credentials=True; esta app sirve
# allow_credentials=False de todas formas, ver app/main.py).
CORS_ORIGINS=http://localhost:5173

# Presupuesto de tiempo (segundos) compartido entre el cálculo simbólico y la
# verificación de pasos (spec, sección 6). Default DEDUCIBLE: 10.
MATH_TIMEOUT_SECONDS=10

# Cantidad de puntos de muestreo por defecto en /graph/2d cuando el cliente
# no especifica `samples` (spec, sección 5: rango permitido [50, 1000]).
# Default DEDUCIBLE: 200.
GRAPH_2D_DEFAULT_POINTS=200
